    "expo-dev-client": "~55.0.32",
    "expo-document-picker": "~55.0.13",
    "expo-status-bar": "~55.0.5",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "^5.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.10",
    "typescript": "~5.9.2"
  }
