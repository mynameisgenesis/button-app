{
  "name": "big-red-button",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "build:android:dev": "eas build --platform android --profile development",
    "android:staging": "eas build --platform android --profile staging",
    "android:release": "eas build --platform android --profile production",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "ios:dev": "eas build --platform ios --profile development",
    "ios:preview": "eas build --platform ios --profile preview",
    "ios:prod": "eas build --platform ios --profile production",
    "ios:release": "eas build --platform ios --profile production --auto-submit",
    "test": "jest --runInBand",
    "ci:publish-check": "npx tsc --noEmit && node ./scripts/validate-publish.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/jest": "29.5.14",
    "@types/react-native": "~0.69.1",
    "expo": "^56.0.4",
    "expo-audio": "~56.0.10",
    "expo-dev-client": "~56.0.15",
    "expo-document-picker": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@testing-library/jest-native": "^4.0.13",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.3",
    "@types/react": "~19.2.10",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "^56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.4",
    "patch-package": "^7.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
